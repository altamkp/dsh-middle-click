{
  "name": "@altamkp/dsh-middle-click",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Middle-click closes a session or a sidebar tab in the DeepSeek Harness Web UI, with its own Settings tab.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altamkp/dsh-middle-click.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.png",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
